{
  "name": "@deepseek-ai/dsh-research-memory",
  "description": "Scoped research sources, attributed working context and scratch note writeback",
  "version": "0.2.1-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
